{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "functions": {
    "app.py": {
      "maxDuration": 30,
      "excludeFiles": "{tests/**,docs/**,public/**,.github/**,.venv/**,**/__pycache__/**,*.db,*.db-*}"
    }
  },
  "crons": [
    {
      "path": "/healthz",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
