# Copy to .env for local development. Never commit .env (it is gitignored).
# On Vercel, set these in Project Settings -> Environment Variables instead.

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Postgres connection string. Leave empty locally to use SQLite.
# Supabase: Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543),
# e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Local SQLite file (used only when DATABASE_URL is empty).
# SQLITE_PATH=budget_tracker.db

# Optional AI features. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Max Gemini calls per user per day (rule-based fallback after that).
# AI_DAILY_LIMIT=40

# Time zone used for "today" and month boundaries.
# APP_TIMEZONE=Asia/Kolkata

# One-click demo accounts on the landing page (deleted after 24h).
# DEMO_MODE_ENABLED=1

# Apply database migrations automatically at startup.
# AUTO_MIGRATE=1

# Local development only.
# FLASK_DEBUG=1
